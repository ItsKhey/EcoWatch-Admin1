<?xml version="1.0" encoding="utf-8"?>
<!--
    Scrollable so the confirm button is always reachable.

    The sheet holds two multi-line fields, a search box and one horizontal
    card row (the team/personnel picker). Together those are taller than a phone
    screen, and a bottom sheet anchors its content to the bottom edge, so
    without a scroll container the button at the end of the layout is simply
    cut off and never rendered. The card row scrolls sideways; this wrapper
    only exists so the form above and the button below it can move.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="?attr/colorOutline" />

    <TextView
        android:id="@+id/assignmentSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/assign_personnel"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/assignmentSheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/assignment_sheet_subtitle"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <!--
        How big the reported waste is, and therefore what has to go out.

        The resident picked the scale when the report was filed, so it is stated
        rather than chosen here: the sheet adapts to it. The Java side bolds the
        first line and picks the scale name out of it in the app green at a
        larger size, so the fact the dispatch must obey lands first.

        Padding lives on the view: the banner shape carries none.
    -->
    <TextView
        android:id="@+id/assignmentScaleBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_dialog_rounded"
        android:lineSpacingExtra="2dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        tools:text="Waste scale: Medium-Scale Waste\nDispatch a cleaning team." />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/assignmentResponseLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/admin_response_label">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/assignmentResponse"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:maxLines="4"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/assignmentResponseLayoutforPersonnel"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/personnel_note_label"
        app:helperText="@string/personnel_note_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/assignmentResponseforPersonnel"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:maxLines="4"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="19dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/colorOutlineVariant" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/assignmentSearchLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:hint="@string/assignment_search_hint"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/assignmentSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--
        What goes out on site. For a medium or large report this row holds the
        named cleaning teams; the administrator taps one available team and the
        whole crew goes out with that dispatch. For a small report the same row
        holds individual personnel, and only people who are not on any team are
        offered so a crew is never pulled apart.
    -->
    <TextView
        android:id="@+id/assignmentTeamLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/assignment_team_label"
        android:textAllCaps="true"
        android:textColor="@color/faint_green_color"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/assignmentCrewHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        tools:text="@string/assignment_crew_hint" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/assignmentCrewCards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/assignmentCrewEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/assignment_no_personnel"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/assignmentVehicleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/assignment_vehicle_label"
        android:textAllCaps="true"
        android:textColor="@color/faint_green_color"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/assignmentVehicleHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/assignment_vehicle_placeholder"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/assignmentVehicleScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/assignmentVehicleCards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/assignmentVehicleEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/assignment_no_vehicles"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/assignmentLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/assignmentConfirm"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:text="@string/assign_personnel"
        android:textAllCaps="false"
        app:cornerRadius="12dp" />

</LinearLayout>

</androidx.core.widget.NestedScrollView>
