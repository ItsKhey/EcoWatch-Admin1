<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/announcementSwipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/activity_create_announcement_toolbar" />

            <LinearLayout
                android:id="@+id/announcementMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_announcement_title"
                android:textColor="?attr/colorPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/create_announcement_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <!-- Announcement Title -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/announcementTitleLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/announcement_field_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/announcementTitleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="150"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Announcement Message -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/announcementMessageLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/announcement_field_message">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/announcementMessageInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="2000"
                    android:minLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Audience -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.1"
                android:text="AUDIENCE"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <RadioGroup
                        android:id="@+id/announcementAudienceGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/audienceAllResidents"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/audience_all_residents"
                            android:textColor="@color/green"
                            android:textSize="14sp" />

                        <!-- Future-ready: shown but not selectable until the
                             backend accepts a narrowed broadcast. -->
                        <RadioButton
                            android:id="@+id/audienceBarangay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/audience_specific_barangay"
                            android:textColor="@color/faint_green_color"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/audienceSelectedResidents"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/audience_selected_residents"
                            android:textColor="@color/faint_green_color"
                            android:textSize="14sp" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/audienceUpcomingNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/audience_upcoming_note"
                        android:textColor="@color/faint_green_color"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Priority -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.1"
                android:text="PRIORITY"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <RadioGroup
                        android:id="@+id/announcementPriorityGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/priorityNormal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/priority_normal"
                            android:textColor="@color/green"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/priorityImportant"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/priority_important"
                            android:textColor="@color/green"
                            android:textSize="14sp" />
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Expiry -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.1"
                android:text="@string/expiry_label"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <RadioGroup
                        android:id="@+id/announcementExpiryGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/expiry1Day"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/expiry_1_day"
                            android:textColor="@color/green"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/expiry3Days"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/expiry_3_days"
                            android:textColor="@color/green"
                            android:textSize="14sp" />

                        <!-- Matches the backend default, so this is what is
                             preselected when the form opens. -->
                        <RadioButton
                            android:id="@+id/expiry7Days"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/expiry_7_days"
                            android:textColor="@color/green"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/expiry14Days"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/expiry_14_days"
                            android:textColor="@color/green"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/expiry30Days"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/expiry_30_days"
                            android:textColor="@color/green"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/expiryNever"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/expiry_never"
                            android:textColor="@color/green"
                            android:textSize="14sp" />
                    </RadioGroup>

                    <!-- Spells out the consequence of the chosen window, since
                         the deadline is permanent and not recoverable. -->
                    <TextView
                        android:id="@+id/expiryNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/expiry_note"
                        android:textColor="@color/faint_green_color"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendAnnouncementBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/send_announcement"
                android:textStyle="bold"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="12dp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/announcementProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?attr/colorPrimary"
                app:trackCornerRadius="4dp"
                app:trackThickness="4dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
