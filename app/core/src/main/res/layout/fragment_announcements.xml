<?xml version="1.0" encoding="utf-8"?>
<!--
  Every announcement the administrator has published, newest first. Rows are
  inflated in code from the live backend response, never from placeholders.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">


    <!-- Header with Centered Announcements Title -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="@color/green" />

        <TextView
            android:id="@+id/announcementsTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/announcements"
            android:textColor="@color/green"
            android:textSize="20sp"
            android:textStyle="bold" />

    </FrameLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/announcementsSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/announcementsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/announcementsEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:alpha="0.8"
        android:gravity="center"
        android:text="@string/announcement_none_yet"
        android:textColor="@color/green"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/announcementsErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:alpha="0.8"
        android:gravity="center"
        android:textColor="@color/green"
        android:textSize="14sp"
        android:visibility="gone" />

    <!--
      Pagination footer. Hidden until a full page comes back, so the control only
      appears when there is genuinely more to fetch.
    -->
    <TextView
        android:id="@+id/announcementsLoadMore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/announcement_load_more"
        android:textColor="@color/green"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/announcementsEndOfList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alpha="0.6"
        android:gravity="center"
        android:text="@string/announcement_end_of_list"
        android:textColor="@color/green"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
