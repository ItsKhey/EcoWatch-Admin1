<?xml version="1.0" encoding="utf-8"?>
<!--
  One report inside an expanded Possible Duplicate Reports card.

  Gives the administrator everything needed to compare two submissions side by
  side: reference, reporter, category, submitted time, description, location,
  distance from the first report, photo and current status. Deliberately no
  database identifiers, coordinates-as-data or backend terminology.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@color/duplicate_review_panel"
    android:orientation="horizontal"
    android:padding="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/reviewRowThumb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/possible_duplicate_report_photo"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery"
        app:cornerRadius="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reviewRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report #—"
            android:textColor="@color/green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reviewRowResident"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Resident: —"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/reviewRowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waste type • submitted"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            tools:text="Organic • Oct 02, 2026 • 9:15 AM" />

        <TextView
            android:id="@+id/reviewRowDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="No description"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/reviewRowLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            tools:text="8 m from the first report" />

        <TextView
            android:id="@+id/reviewRowStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Status: Pending"
            android:textColor="@color/green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>