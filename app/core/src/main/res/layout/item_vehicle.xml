<?xml version="1.0" encoding="utf-8"?>
<!--
  One vehicle in the fleet.

  Mirrors item_personnel.xml card for card, so the two lists read as the same
  kind of screen: a 48dp image, the name and a subtitle, a task line, an activity
  line, two status chips and Locate / View Details. Only the fields differ, and
  they line up with the vehicle equivalents the selector promises.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:strokeColor="#06402B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top: vehicle icon + plate number and type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- The truck illustration the fleet ships with, used for every
                 vehicle. Vehicles have no uploaded photo, so this is the whole
                 identity row rather than a placeholder that is rarely seen. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/vehicleIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/vehicle_icon_description"
                android:scaleType="centerCrop"
                android:src="@drawable/garbage_truck"
                app:shapeAppearanceOverlay="@style/CircleImage" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/vehiclePlate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/vehicleSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- Current collection: the vehicle's equivalent of "current task" -->
        <TextView
            android:id="@+id/vehicleCurrentCollection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Last service: the vehicle's equivalent of "last active" -->
        <TextView
            android:id="@+id/vehicleLastService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="Vehicle Status:"/>

            <TextView
                android:id="@+id/vehicleMaintenanceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Available" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="Vehicle Availability:"/>

            <TextView
                android:id="@+id/vehicleAvailability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Lacks A Driver" />
        </LinearLayout>

        <!--
          The driver assigned to this truck.

          The mirror of the Assigned Vehicle card on the personnel list: same
          MaterialCardView, same 14dp radius, same #06402B hairline, same
          icon / label / primary / secondary stacking, so the two halves of the
          selector describe a driver and their truck identically. Only the icon
          differs, and it has to: the person is the subject here, so it is their
          avatar rather than another picture of the truck the card is already
          showing.

          Hidden for a truck with no driver, which is every truck but the ones a
          Driver account was given at registration.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vehiclePersonnelCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="14dp"
            app:strokeColor="#06402B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/vehiclePersonnelAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/personnel_name_label"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_person_default"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/personnel_assigned_personnel"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/vehiclePersonnelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/vehiclePersonnelId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Locate + View Details, matching the personnel card's action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocateVehicle"
                style="@style/Widget.MyEcoWatch1.CardActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/locate" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVehicleDetails"
                style="@style/Widget.MyEcoWatch1.CardActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_details" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
