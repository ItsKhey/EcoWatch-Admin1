<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->

    <!-- Header with Centered Title and Subtitle -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <!-- Centered Title and Subtitle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/historyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textColor="@color/green"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administrative activity and records"
                android:textColor="@color/green"
                android:textSize="11sp"
                android:alpha="0.7" />

        </LinearLayout>

        <!-- Back Button on the Left -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="@color/green" />

    </FrameLayout>

    <!-- Search Bar and Sort -->
    <LinearLayout
        android:id="@+id/searchSortLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/search_bar_background"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/green" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search history..."
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/green"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:autofillHints="none" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/green"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDateFilter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/search_bar_background"
            android:contentDescription="Filter history by date"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_history_filter"
            app:tint="@color/green" />

        <ImageButton
            android:id="@+id/btnSort"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/search_bar_background"
            android:src="@drawable/sort"
            app:tint="@color/green" />
    </LinearLayout>

    <!-- Filter Summary Results Counter -->
    <TextView
        android:id="@+id/filterSummaryText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/green"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Improved Scrollable Custom Tab Pill Container -->
    <HorizontalScrollView
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabPillContainer"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:background="@drawable/white_pill_background"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="All (0)"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/active_pill_background"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabReport"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Reports (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabAssignments"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Assignments (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />


            <TextView
                android:id="@+id/tabCleaning"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Cleaning (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabESPAccounts"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Account (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />
            
            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="8dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/tabTrash"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="100dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Trash (0)"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>


    <!--
        Select All. Visibility is driven from onSelectionChanged() alongside the
        bulk bar, so it appears only when there is at least one row to select.
    -->
    <LinearLayout
        android:id="@+id/selectAllLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/btnSelectAllBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Select all visible records"
            android:buttonTint="@color/green" />

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select All"
            android:textColor="@color/green"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historyRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!--
            Empty state. Text is swapped per tab, because "no reports" and
            "trash is empty" call for different messages.
        -->
        <TextView
            android:id="@+id/historyEmptyText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="No history records yet."
            android:textColor="@color/green"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!--
        Bulk Actions Bar.

        Hidden until a card is long pressed, and hidden again with no rows to act
        on. Archive belongs to the feed, Restore to the trash; the fragment swaps
        them so a reversible and an irreversible bulk action are never one tap
        apart.
    -->
    <LinearLayout
        android:id="@+id/bulkActionsBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="20dp"
        android:background="@color/white"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnArchiveBulk"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Archive"
            android:textColor="@color/green"
            android:visibility="gone"
            app:icon="@android:drawable/ic_menu_save"
            app:iconTint="@color/green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestoreBulk"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Restore"
            android:textColor="@color/green"
            android:visibility="gone"
            app:icon="@android:drawable/ic_menu_revert"
            app:iconTint="@color/green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteBulk"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete"
            android:textColor="#D32F2F"
            app:icon="@drawable/ic_delete_forever"
            app:iconTint="#D32F2F" />

    </LinearLayout>


</LinearLayout>
