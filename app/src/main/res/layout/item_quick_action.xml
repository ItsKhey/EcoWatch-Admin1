<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#06402B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/quickActionIconContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circular_green_background">

            <TextView
                android:id="@+id/quickActionIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="📢"
                android:textSize="18sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/quickActionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Quick Action"
            android:textColor="@color/green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quickActionDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.8"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Description text"
            android:textColor="@color/green"
            android:textSize="11sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
