<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ongoingCleaningCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardElevation="2dp"
    app:cardCornerRadius="16dp"
    app:strokeColor="#06402B"
    app:strokeWidth="1dp">

    <!-- ADD THIS WRAPPER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:padding="16dp">

        <!-- Title + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ongoingTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Report title"
                android:textColor="@color/green"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/ongoingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/reporter_report_status_badge"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="In Progress"
                android:textColor="@color/green"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Report ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report ID:"
                android:textColor="@color/faint_green_color"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/ongoingReportId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="REP-00000000"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Assigned -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned to:"
                android:textColor="@color/faint_green_color"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/ongoingAssignedTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Unassigned"
                android:textColor="@color/green"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Started -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Started:"
                android:textColor="@color/faint_green_color"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/ongoingStartedAt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Not yet started"
                android:textColor="@color/green"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location:"
                android:textColor="@color/faint_green_color"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/ongoingLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="No coordinates"
                android:textColor="@color/green"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/ongoingMapHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="View on map →"
            android:textColor="@color/green"
            android:textSize="12sp"
            android:textStyle="bold"/>


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>