<?xml version="1.0" encoding="utf-8"?>
<!--
  One legend row: a colored swatch plus a label. Included once per entry in
  map_legend.xml rather than repeated inline, so every row lines up the same.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <FrameLayout
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/legendDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/map_legend_dot" />

        <TextView
            android:id="@+id/legendBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:visibility="gone"
            android:textColor="@color/green"
            android:textSize="11sp"
            android:textStyle="bold" />

    </FrameLayout>

    <TextView
        android:id="@+id/legendLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp" />

</LinearLayout>
