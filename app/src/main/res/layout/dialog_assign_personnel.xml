<?xml version="1.0" encoding="utf-8"?>
<!--
    Scrollable so the confirm button is always reachable.

    The sheet holds two multi-line fields, a search box and a bounded personnel
    list. Together those are taller than a phone screen, and a bottom sheet
    anchors its content to the bottom edge, so without a scroll container the
    button at the end of the layout is simply cut off and never rendered. The
    personnel list keeps its own height and scrolls internally; this wrapper only
    exists so the form above and the button below it can move.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="?attr/colorOutline" />

    <TextView
        android:id="@+id/assignmentSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/assign_personnel"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/assignmentSheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/assignment_sheet_subtitle"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <!--
        How big the reported waste is, and therefore what has to go out.

        The resident picked the scale when the report was filed, so it is stated
        rather than chosen here: the sheet adapts to it.
    -->
    <TextView
        android:id="@+id/assignmentScaleBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_scale_banner"
        android:textColor="@color/light_green"
        android:textSize="13sp"
        tools:text="Medium-Scale Waste — dispatch a cleaning team." />

    <!-- The crew. Only shown for the scales that need one. -->
    <TextView
        android:id="@+id/assignmentTeamLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/assignment_team_label"
        android:textAllCaps="true"
        android:textColor="@color/faint_green_color"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textStyle="bold"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/assignmentTeamSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

    <!-- The truck. Only shown for the scale that needs one. -->
    <TextView
        android:id="@+id/assignmentVehicleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/assignment_vehicle_label"
        android:textAllCaps="true"
        android:textColor="@color/faint_green_color"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textStyle="bold"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/assignmentVehicleSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/assignmentSearchLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/assignment_search_hint"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/assignmentSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/assignmentResponseLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/admin_response_label">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/assignmentResponse"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:maxLines="4"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/assignmentResponseLayoutforPersonnel"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/personnel_note_label"
        app:helperText="@string/personnel_note_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/assignmentResponseforPersonnel"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="2000"
            android:maxLines="4"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/assignmentPersonnelList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/assignmentLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/assignmentEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/assignment_no_personnel"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/assignmentConfirm"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:text="@string/assign_personnel"
        android:textAllCaps="false"
        app:cornerRadius="12dp" />

</LinearLayout>

</androidx.core.widget.NestedScrollView>
