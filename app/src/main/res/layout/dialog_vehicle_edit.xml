<?xml version="1.0" encoding="utf-8"?>
<!--
  Add or edit a vehicle.

  One layout serves both jobs, but the two ask different questions. Adding asks
  what the truck IS: plate number, vehicle type and rated load capacity. Status
  and notes are lifecycle facts, and a vehicle joining the fleet has neither yet,
  so VehicleDialogs hides those two rows on the add path.

  Editing shows all five, because that is the moment a truck actually goes out,
  gets serviced or is written up.

  Status is a dropdown rather than a toggle because Maintenance is a state of its
  own, not the absence of an assignment, and picking "Available" has to be an
  explicit act that also releases the vehicle from any collection.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/vehicleDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vehicle_add_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vehicleDialogSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/vehicle_add_subtitle"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/vehiclePlateLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/vehicle_plate_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/vehiclePlateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="20"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/vehicleTypeLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/vehicle_type_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/vehicleTypeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLength="60"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/vehicleRatedLoadLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/vehicle_rated_load_label"
            app:helperText="@string/vehicle_rated_load_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/vehicleRatedLoadInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLength="40"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--
          Hidden on the add path; see the header. A new vehicle is Available, so
          there is only one value the server would accept here.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/vehicleStatusLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/vehicle_status_label"
            android:visibility="gone">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/vehicleStatusInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--
          Only shown when the status is Assigned. A vehicle parked in a state the
          server will reject is worse than one the form never offered, so the
          report field appears exactly when it is needed.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/vehicleReportLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/vehicle_collection_report_label"
            android:visibility="gone"
            app:helperText="@string/vehicle_collection_report_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/vehicleReportInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="50"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Hidden on the add path; see the header. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/vehicleNotesLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/vehicle_notes_label"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/vehicleNotesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vehicleSaveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/vehicle_save"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vehicleCancelBtn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cancel"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>
</ScrollView>
