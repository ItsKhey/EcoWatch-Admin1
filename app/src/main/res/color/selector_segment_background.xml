<?xml version="1.0" encoding="utf-8"?>
<!--
  Selector segment background.

  Separate from the filter chips because a selector segment is a wide, tall pill
  with an icon above a label, and reusing the chip colour selector would give it
  the chip's 100dp radius on a much taller shape.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/light_green" android:state_checked="true" />
    <item android:color="@color/selector_segment_unselected" />
</selector>
