<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyEcoWatch1" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/green</item>
        <item name="colorOutlineVariant">#F0F0F0</item>
    </style>

    <style name="Theme.MyEcoWatch1" parent="Base.Theme.MyEcoWatch1" />

    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="UCropTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryDark">@color/green</item>
    </style>

    <style name="Widget.MyEcoWatch1.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/filter_chip_background_color</item>
        <item name="android:textColor">@color/filter_chip_text_color</item>
        <item name="chipStrokeWidth">0.5dp</item>
        <item name="chipStrokeColor">#E0E0E0</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!--
      The compact outlined button on a list card. Named rather than written out
      again per layout so the vehicle and personnel cards cannot drift apart.
      item_personnel.xml still carries its copy inline; this style produces the
      same rendering and is what new rows should use.
    -->
    <style name="Widget.MyEcoWatch1.CardActionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <!--
      One segment of the Personnel/Vehicles selector.

      Stretched flat with an icon stacked above the label, which is why it is a
      filled toggle button rather than a chip: the chip style carries a 100dp
      radius and a checked icon, both wrong for a wide two-up control.
    -->
    <style name="Widget.MyEcoWatch1.SelectorSegment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/selector_segment_text_color</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/selector_segment_background</item>
        <item name="iconTint">@color/selector_segment_text_color</item>
        <item name="iconSize">20dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">#06402B</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>