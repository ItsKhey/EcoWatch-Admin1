<?xml version="1.0" encoding="utf-8"?>
<!--
    The availability dot on a crew or truck card: green, ringed in white so it
    stays readable over a photo or an illustration.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#2E7D32" />
    <stroke
        android:width="2dp"
        android:color="#FFFFFF" />
</shape>
