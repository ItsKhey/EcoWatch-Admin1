<?xml version="1.0" encoding="utf-8"?>
<!--
    The "no reports" heatmap cell and its legend swatch.

    Hollow rather than filled, so a day with nothing to report is not mistaken for
    a filled intensity step. The stroke is a fixed light green in both themes, so
    the outline stays visible over the calendar's dark green card as well as on the
    legend's page background.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/calendar_heatmap_empty_stroke" />
</shape>
